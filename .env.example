# =============================================================================
# Container runtime (src/start.sh)
# =============================================================================
# Set to "true" to run handler with `--rp_serve_api` on 0.0.0.0 for local/API testing.
SERVE_API_LOCALLY=
# Optional. Hugging Face cache location. The default accelerate config is written under it. Default: ~/.cache/huggingface
# HF_HOME=

# =============================================================================
# Optional S3 upload after training
# =============================================================================
# Configure these values in the worker environment when using S3 uploads.

BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Private output destination, using the existing bucket connection credentials.
R2_PRIVATE_BUCKET=private-model-outputs
