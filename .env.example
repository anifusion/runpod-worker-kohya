# =============================================================================
# Container runtime (src/start.sh)
# =============================================================================
# Set to "true" to run handler with `--rp_serve_api` on 0.0.0.0 for local/API testing.
SERVE_API_LOCALLY=
# Optional. Hugging Face cache location. The default accelerate config is written under it. Default: ~/.cache/huggingface
# HF_HOME=

# =============================================================================
# Model storage (S3-compatible)
# =============================================================================
# A deployed worker needs storage credentials, either from the job's bucket
# settings or from these variables. Without them the job fails. The endpoint is
# the storage account URL, optionally followed by one path segment naming the
# public bucket, for example https://<account>.storage.example.com/<public-bucket>.
# Public LoRAs are written to <public-bucket>/lora/<id>.safetensors, or to the
# legacy "lora" bucket when the endpoint names none. The credentials must be able
# to write, and should be able to read, every bucket the worker writes to.

BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Private LoRAs are written to this bucket at private-v1/lora/<id>.safetensors,
# using the same storage account and credentials.
R2_PRIVATE_BUCKET=private-model-outputs

# Local development only: set to 1 to copy the LoRA to local_upload/ when no
# storage credentials are configured. Never set this on a deployed worker.
ALLOW_LOCAL_LORA_UPLOAD=
